-- ===== CORE FUNCTIONS =====

-- Collect from collectors
local function CollectMoney()
    local root = getRootPart()
    if not root then return end
    
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then return end
    
    for _, plot in ipairs(plots:GetChildren()) do
        local collectorParts = plot:FindFirstChild("CollectorParts")
        if collectorParts then
            for _, part in ipairs(collectorParts:GetChildren()) do
                if part.Name == "Collector" then
                    local ti = part:FindFirstChild("TouchInterest")
                    if ti then
                        firetouchinterest(part, root, 0)
                        task.wait(0.02)
                        firetouchinterest(part, root, 1)
                    end
                end
            end
        end
    end
end

-- Collect Money Crates from map
local function CollectDrops()
    local root = getRootPart()
    if not root then return end
    
    for _, part in ipairs(Workspace:GetChildren()) do
        if part:IsA("Part") and string.find(part.Name, "Money Crate") then
            local ti = part:FindFirstChild("TouchInterest")
            if ti then
                firetouchinterest(part, root, 0)
                task.wait(0.02)
                firetouchinterest(part, root, 1)
            end
        end
    end
end

-- Rebirth
local function DoRebirth()
    if BuyRebirth then
        pcall(function()
            BuyRebirth:FireServer()
        end)
    end
end

-- Activate Nuke
local function ActivateNuke()
    if BuyNukeWithMoney then
        pcall(function()
            BuyNukeWithMoney:FireServer()
        end)
    end
    
    -- Also try clicking GUI button
    local playerGui = Player.PlayerGui
    if playerGui then
        local main = playerGui:FindFirstChild("Main")
        if main then
            local guiFrames = main:FindFirstChild("GuiFrames")
            if guiFrames then
                local troll = guiFrames:FindFirstChild("Troll")
                if troll then
                    local buttons = troll:FindFirstChild("Buttons")
                    if buttons then
                        local nukeButton = buttons:FindFirstChild("NukeForMoney")
                        if nukeButton then
                            nukeButton:Click()
                        end
                    end
                end
            end
        end
    end
end

-- Claim daily reward
local function ClaimDaily()
    if ClaimDailyReward then
        pcall(function()
            ClaimDailyReward:FireServer()
        end)
    end
    
    local playerGui = Player.PlayerGui
    if playerGui then
        local main = playerGui:FindFirstChild("Main")
        if main then
            local guiFrames = main:FindFirstChild("GuiFrames")
            if guiFrames then
                local dailyReward = guiFrames:FindFirstChild("DailyReward")
                if dailyReward then
                    local claimButton = dailyReward:FindFirstChild("Claim")
                    if claimButton then
                        claimButton:Click()
                    end
                end
            end
        end
    end
end


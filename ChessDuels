-- The engine module is shared, so every call that touches a position goes
-- through this lock. Two searches running at once return empty results and
-- corrupt the module's scratch buffer. The guarded bodies never yield, and a
-- lock older than a few seconds is treated as abandoned so a single failure
-- cannot freeze the whole script.
local engineLock = { held = false, since = 0 }
local ENGINE_LOCK_TIMEOUT = 5

local function withEngine(body)
	while engineLock.held do
		if os.clock() - engineLock.since > ENGINE_LOCK_TIMEOUT then
			engineLock.held = false
			break
		end
		task.wait(0.01)
	end
	engineLock.held = true
	engineLock.since = os.clock()
	local ok, first, second = pcall(body)
	engineLock.held = false
	if not ok then
		error(first, 0)
	end
	return first, second
end


local function pushCandidates(result)
	CandidateLog:Clear()
	if not result or not result.top then
		return
	end
	for index, candidate in ipairs(result.top) do
		local tag = index == 1 and "Success" or "Muted"
		CandidateLog:Push(
			"<" .. tag .. ">#" .. index .. " " .. tostring(candidate.san) .. "</" .. tag .. ">  " .. formatEvaluation(candidate.score, result.turn),
			"Text"
		)
	end
end


-- Element callbacks fire while the window is being built, sometimes with nil,
-- so the runtime settings are read back from the saved flags once the whole
-- tree exists. This keeps the first render honest.
local function syncSettingsFromFlags()
	local flags = Airflow.Flags or {}

	local function readNumber(flag, fallback)
		local handle = flags[flag]
		if not handle then
			return fallback
		end
		local ok, value = pcall(function()
			return handle:Get()
		end)
		if ok and type(value) == "number" then
			return value
		end
		return fallback
	end

	local function readBoolean(flag, fallback)
		local handle = flags[flag]
		if not handle then
			return fallback
		end
		local ok, value = pcall(function()
			return handle:Get()
		end)
		if ok and type(value) == "boolean" then
			return value
		end
		return fallback
	end

	Settings.autoPlay = readBoolean("ChessAutoPlay", Settings.autoPlay)
	Settings.showBest = readBoolean("ChessShowBest", Settings.showBest)
	Settings.showTop = readBoolean("ChessShowTop", Settings.showTop)
	Settings.showBadge = readBoolean("ChessBadge", Settings.showBadge)
	Settings.depth = readNumber("ChessDepth", Settings.depth)
	Settings.delay = readNumber("ChessDelay", Settings.delay)
	Settings.thickness = readNumber("ChessThickness", Settings.thickness)
	Settings.opacity = readNumber("ChessOpacity", Settings.opacity * 100) / 100

	local levelHandle = flags.ChessBotLevel
	if levelHandle then
		local ok, value = pcall(function()
			return levelHandle:Get()
		end)
		if ok and type(value) == "string" then
			Settings.botLevel = value
		end
	end
end


local function unload()
	State.running = false
	State.enabled = false
	resetCamera()
	for _, c in ipairs(conns) do
		pcall(function()
			c:Disconnect()
		end)
	end
	table.clear(conns)
	pcall(function()
		UI:Unload()
	end)
	genv.__VF_RUNNING = nil
	genv.__VF_SHUTDOWN = nil
end

genv.__VF_SHUTDOWN = unload


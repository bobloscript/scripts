        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
    }
    for key, value in pairs(properties or {}) do
        values[key] = value
    end
    return create("TextLabel", values, parent)
end


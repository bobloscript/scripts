-- Keep the complete interface on whole pixels. Fractional scaling and
-- half-pixel centering are another common source of blurry Roblox UI.
local function snapWindowToPixels()
    local viewport = overlay.AbsoluteSize
    if viewport.X < 2 or viewport.Y < 2 then
        return
    end

    local mobileViewport = viewport.X < 760 or viewport.Y < 620
    local width
    local height

    if mobileViewport then
        -- Mobile windows breathe inside the viewport instead of occupying
        -- almost every available pixel.
        width = math.min(700, math.floor(viewport.X * 0.94), viewport.X - 12)
        height = math.min(620, math.floor(viewport.Y * 0.88), viewport.Y - 16)
        width = math.max(240, width)
        height = math.max(300, height)
    else
        width = math.min(900, math.max(260, viewport.X - 24))
        height = math.min(680, math.max(360, viewport.Y - 24))
    end

    width = math.min(viewport.X, math.floor(width / 2) * 2)
    height = math.min(viewport.Y, math.floor(height / 2) * 2)

    local x = math.floor((viewport.X - width) / 2)
    local y = math.floor((viewport.Y - height) / 2)

    window.Size = UDim2.fromOffset(width, height)
    window.Position = UDim2.fromOffset(x, y)
end


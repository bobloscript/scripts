    if code == "ru" then
        addStripe(container, hex("FFFFFF"), 0, 1 / 3, 15)
        addStripe(container, hex("3264BE"), 1 / 3, 1 / 3, 15)
        addStripe(container, hex("D94A54"), 2 / 3, 1 / 3, 15)
    elseif code == "es" then
        addStripe(container, hex("C93B43"), 0, 0.25, 15)
        addStripe(container, hex("F5C84B"), 0.25, 0.5, 15)
        addStripe(container, hex("C93B43"), 0.75, 0.25, 15)
    else
        for index = 0, 6 do
            addStripe(
                container,
                index % 2 == 0 and hex("D94A54") or hex("F6F6F6"),
                index / 7,
                1 / 7 + 0.01,
                15

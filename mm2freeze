        whyText.Position = UDim2.fromOffset(72, 39)
        whyText.Size = UDim2.new(1, -92, 0, 34)
    end

    local smallText = compact and 12 or 13
    signsTitle.TextSize = compact and 14 or 15
    actionsTitle.TextSize = compact and 14 or 15
    signsSubtitle.TextSize = compact and 11 or 12
    actionsSubtitle.TextSize = compact and 11 or 12
    freezeWarningText.TextSize = compact and 13 or 15
    weaponWarningText.TextSize = compact and 13 or 15
    lossWarningText.TextSize = compact and 12 or 14
    whyTitle.TextSize = compact and 13 or 14
    whyText.TextSize = compact and 12 or 13

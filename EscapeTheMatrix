local AutoTrade
AutoTrade = AutoBox:CreateToggle({
    Name = "Auto trade",
    Desc = "Follows the strongest trend, takes profit and stops the loss",
    Flag = "TradexAuto",
    CurrentValue = false,
    Callback = function(on)
        if not on then
            logPush("<Muted>Stopped</Muted>")
            return
        end
        logPush(dryRun and "<Success>Started (dry run)</Success>" or "<Warning>Started with in-game cash</Warning>")
        task.spawn(function()
            while AutoTrade.Value do
                for sym, position in pairs(positions()) do
                    if not AutoTrade.Value or dryRun then
                        break
                    end
                    local asset = marketOf(sym)
                    local cost = tonumber(position.cost) or 0
                    local count = tonumber(position.q) or 0
                    if asset and cost > 0 and count > 0 then
                        local value = count * (tonumber(asset.p) or 0) * 100
                        local pnl = (value - cost) / cost * 100
                        if pnl >= takeProfit or pnl <= -stopLoss then
                            sellAll(sym)
                        elseif strategy == "trend" then
                            local bias = select(1, trendInfo(sym, asset.cat or "stock"))
                            if bias < 0.02 then
                                logPush("<Muted>Trend gone: " .. tostring(sym) .. "</Muted>")
                                sellAll(sym)
                            end
                        end
                    end
                end
                for sym, entry in pairs(paper) do
                    if not AutoTrade.Value then
                        break
                    end
                    local asset = marketOf(sym)
                    local price = asset and tonumber(asset.p) or 0
                    if price > 0 and entry.px > 0 then
                        local pnl = (price - entry.px) / entry.px * 100
                        if pnl >= takeProfit or pnl <= -stopLoss then
                            paperRealized += (price - entry.px) * entry.qty * 100
                            paper[sym] = nil
                            exitBlock[sym] = minutesNow()
                            local tone = pnl >= 0 and "Success" or "Error"
                            logPush(string.format("<%s>Paper sold %s %.1f%%</%s>", tone, tostring(sym), pnl, tone))
                        elseif strategy == "trend" then
                            local bias = select(1, trendInfo(sym, (asset and asset.cat) or "stock"))
                            if bias < 0.02 then
                                paperRealized += (price - entry.px) * entry.qty * 100
                                paper[sym] = nil
                                exitBlock[sym] = minutesNow()
                                logPush(string.format("<Muted>Paper exit %s, trend gone</Muted>", tostring(sym)))
                            end
                        end
                    end
                end
                scanSome(3)
                local held = openCount() + (function()
                    local count = 0
                    for _ in pairs(paper) do
                        count += 1
                    end
                    return count
                end)()
                if AutoTrade.Value and held < maxPositions then
                    local bestSym, bestScore = nil, -math.huge
                    for sym, entry in pairs(scan) do
                        if type(entry) == "table" and entry.score > bestScore and eligible(entry)
                            and not positions()[sym] and not paper[sym] and not recentlySold(sym) then
                            bestSym, bestScore = sym, entry.score
                        end
                    end
                    if bestSym then
                        local asset = marketOf(bestSym)
                        local cash = tonumber((Net.state.core or {}).cash) or 0
                        local budget = math.min(perTrade, math.floor(cash * 0.15))
                        local record = scan[bestSym] or {}
                        -- A hot trend makes the same score riskier: demand more edge.
                        if asset and budget >= 5000 and bestScore >= entryScore * (1 + (record.volatility or 0)) then
                            local price = tonumber(asset.p) or 0
                            local wanted = math.floor(budget / 100 / (price * (1 + feeOf(asset.cat)) * 1.01))
                            if wanted >= 1 then
                                local context = (record.names and #record.names > 0) and (", " .. table.concat(record.names, "/")) or ""
                                if dryRun then
                                    paper[bestSym] = { qty = wanted, px = price }
                                    logPush(string.format("<Muted>Paper buy %d %s at %s (score %.1f%s)</Muted>", wanted, bestSym, priceText(price), bestScore, context))
                                else
                                    logPush(string.format("<Muted>Signal %.1f%s</Muted>", bestScore, context))
                                    buyUnits(bestSym, wanted)
                                end
                            end
                        end
                    end
                end
                task.wait(2)
            end
        end)
    end,
})


    local function findById(list, id)
        for _, item in ipairs(list) do
            if item.id == id then
                return item
            end
        end
        return list[1]
    end

    local function genreTrend(genreId)
        local multiplier = 1
        for _, trend in ipairs((Net.state.trends or {}).active or {}) do
            local entry = TrendData and TrendData.byId and TrendData.byId[trend.id]
            local effect = entry and entry.effects and entry.effects.genre and entry.effects.genre[genreId]
            if effect then
                multiplier *= 1 + effect * (trend.pop or 0)
            end
        end
        return multiplier
    end

    local function fitOf(combo)
        local themeFit = (RobluxData.THEME_FIT[combo.genre] or {})[combo.theme] or 1
        local mechFit = (RobluxData.MECH_FIT[combo.genre] or {})[combo.mech] or 1
        local audFit = (RobluxData.AUD_FIT[combo.genre] or {})[combo.aud] or 1
        return themeFit * mechFit * audFit
    end

    local function comboLabel(fit)
        if fit >= 1.4 then
            return "Great combo x%.2f"
        elseif fit >= 1.1 then
            return "Good combo x%.2f"
        elseif fit >= 0.9 then
            return "Okay combo x%.2f"
        end
        return "Odd combo x%.2f"
    end

    local function bestForGenre(genre)
        local best = nil
        for _, theme in ipairs(RobluxData.THEMES) do
            for _, mech in ipairs(RobluxData.MECHS) do
                for _, aud in ipairs(RobluxData.AUDIENCES) do
                    local combo = { genre = genre.id, theme = theme.id, mech = mech.id, aud = aud.id }
                    local fit = fitOf(combo)
                    if not best or fit > best.fit then
                        best = { genre = genre, theme = theme, mech = mech, aud = aud, fit = fit }
                    end
                end
            end
        end
        best.trend = genreTrend(genre.id)
        best.score = best.fit * best.trend
        return best
    end

    local function ranking()
        local list = {}
        for _, genre in ipairs(RobluxData.GENRES) do
            table.insert(list, bestForGenre(genre))
        end
        table.sort(list, function(first, second)
            return first.score > second.score
        end)
        return list
    end

    local genreOptions, themeOptions, mechOptions, audOptions = {}, {}, {}, {}

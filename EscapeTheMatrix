-- Same list the BrainrotTok "Trending" tab shows: state.trends.active. The game states
-- that live trends move TradeX prices, so they belong in the signal. Numbers come from
-- Shared.TrendData (asset / assetCat / vol), the active entry only carries id and timing.
local function trendInfo(sym, category)
    local bias, volatility, names = 0, 0, {}
    local minutes = tonumber((Net.state.core or {}).minutes) or 0
    local dominant, dominantPhase = 0, 1
    for _, trend in ipairs((((Net.state.trends or {}).active) or {})) do
        local definition = TrendData and TrendData.byId and TrendData.byId[trend.id]
        local effects = definition and definition.effects
        if effects then
            local lift = 0
            if effects.asset and effects.asset[sym] then
                lift += tonumber(effects.asset[sym]) or 0
            end
            if effects.assetCat and effects.assetCat[category] then
                lift += tonumber(effects.assetCat[category]) or 0
            end
            local extraVol = 0
            if effects.vol and effects.vol[category] then
                extraVol = tonumber(effects.vol[category]) or 0
            end
            if lift ~= 0 or extraVol ~= 0 then
                local started = tonumber(trend.start) or minutes
                local ends = tonumber(trend.ends) or (minutes + 1)
                local phase = 0
                if ends > started then
                    phase = math.clamp((minutes - started) / (ends - started), 0, 1)
                end
                local weight = 0.3 + 0.7 * (1 - phase)
                bias += lift * weight
                volatility += extraVol * weight
                if math.abs(lift) > math.abs(dominant) then
                    dominant = lift
                    dominantPhase = phase
                end
                table.insert(names, tostring(trend.name or trend.id))
            end
        end
    end
    return bias, volatility, names, dominantPhase
end


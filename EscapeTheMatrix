local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ETM = ReplicatedStorage:WaitForChild("ETM", 30)
if not ETM then
    return warn("[Robscript ETM] Escape The Matrix was not found in ReplicatedStorage")
end

local Client = ETM:WaitForChild("Client", 15)
local Shared = ETM:WaitForChild("Shared", 15)
if not Client or not Shared then
    return warn("[Robscript ETM] game modules are missing")
end

local okNet, Net = pcall(function()
    return require(Client:WaitForChild("Net", 10))
end)
if not okNet or type(Net) ~= "table" then
    return warn("[Robscript ETM] network layer is unavailable: " .. tostring(Net))
end

local okFormat, Format = pcall(function()
    return require(Shared:WaitForChild("Format", 10))
end)
if not okFormat then
    Format = nil
end


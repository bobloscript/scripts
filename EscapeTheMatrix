                if started.ok and type(started.gig) == "table" then
                    local answers, kind = solveGig(started.gig)
                    if answers then
                        local submitted = request("GigSubmit", answers)
                        if submitted.ok then
                            local verdict = tostring(submitted.verdict or kind)
                            if (submitted.pay or 0) > 0 then
                                results:Push("<Success>+" .. money(submitted.pay) .. "</Success> <Muted>" .. verdict .. "</Muted>")

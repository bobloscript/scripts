local WORDS = {}
for word in string.gmatch(WORD_LIST, "%S+") do
    WORDS[word] = true
end

local ALPHABET = "abcdefghijklmnopqrstuvwxyz"

local function cleanWord(raw)
    return string.lower((string.gsub(tostring(raw), "[^%a]", "")))
end

local function nearDictionaryWord(word)
    local length = #word
    for index = 1, length do
        if WORDS[string.sub(word, 1, index - 1) .. string.sub(word, index + 1)] then
            return true
        end
    end
    for index = 1, length - 1 do
        local first = string.sub(word, index, index)
        local second = string.sub(word, index + 1, index + 1)
        if first ~= second then
            local candidate = string.sub(word, 1, index - 1) .. second .. first .. string.sub(word, index + 2)
            if WORDS[candidate] then
                return true
            end
        end
    end
    for index = 1, length do
        local head = string.sub(word, 1, index - 1)
        local tail = string.sub(word, index + 1)
        local original = string.sub(word, index, index)
        for position = 1, 26 do
            local letter = string.sub(ALPHABET, position, position)
            if letter ~= original then
                if WORDS[head .. letter .. tail] then
                    return true
                end
            end
        end
    end
    for index = 1, length + 1 do
        local head = string.sub(word, 1, index - 1)
        local tail = string.sub(word, index)
        for position = 1, 26 do
            local letter = string.sub(ALPHABET, position, position)
            if WORDS[head .. letter .. tail] then
                return true
            end
        end
    end
    return false
end

local function pickCategory(name, categories)
    local lower = string.lower(tostring(name))
    for _, rule in ipairs(TAG_KEYWORDS) do
        if string.find(lower, rule[1], 1, true) then
            for _, category in ipairs(categories or {}) do
                if string.lower(tostring(category)) == string.lower(rule[2]) then
                    return category
                end
            end
            return rule[2]
        end
    end
    return nil
end

local function looksLikeScam(text)
    local lower = string.lower(tostring(text))
    for _, word in ipairs(SCAM_KEYWORDS) do
        if string.find(lower, word, 1, true) then
            return true
        end
    end
    return false
end

local function solveProof(gig)
    local words = gig.words or {}
    local needed = tonumber(string.match(tostring(gig.brief or ""), "(%d+)%s+misspelled"))
        or tonumber(string.match(tostring(gig.brief or ""), "the%s+(%d+)"))
        or 3
    local suspect, unknown = {}, {}
    for index, raw in ipairs(words) do
        local word = cleanWord(raw)
        if word ~= "" and not WORDS[word] then
            if nearDictionaryWord(word) then
                table.insert(suspect, index)
            else
                table.insert(unknown, index)
            end
        end
    end
    local picks = {}
    for _, index in ipairs(suspect) do
        if #picks < needed then
            table.insert(picks, index)
        end
    end
    for _, index in ipairs(unknown) do
        if #picks < needed then
            table.insert(picks, index)
        end
    end
    return picks, "proof"
end

local function solveGig(gig)
    local kind = gig.kind
    local items = gig.items or {}
    if kind == "tag" then
        local categories = gig.cats or {}
        local answers = {}
        for index, item in ipairs(items) do
            local category = pickCategory(item, categories)
            answers[index] = category or categories[((index - 1) % math.max(#categories, 1)) + 1] or ""
        end
        return answers, kind
    end
    if kind == "scam" then
        local answers = {}
        for index, item in ipairs(items) do
            answers[index] = looksLikeScam(item)
        end
        return answers, kind
    end
    if kind == "proof" then
        return solveProof(gig)
    end
    return nil, kind
end


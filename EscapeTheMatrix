local function firstOffer()
    local project = currentProject()
    if not project then
        return nil, nil
    end
    local list = project.offers or {}
    return project, list[1]
end

local function parseMoney(text)
    local digits = string.match(tostring(text or ""), "%$([%d,]+)")
    if not digits then
        return nil
    end
    local value = tonumber((string.gsub(digits, ",", "")))
    if not value then
        return nil
    end
    return value * 100
end

local function parsePercent(text)
    local value = string.match(tostring(text or ""), "(%d+)%%")
    return tonumber(value)
end

local function offerSummary(project, offer)
    local money = nil
    local percent = nil
    for _, line in ipairs(offer.terms or {}) do
        money = money or parseMoney(line)
        percent = percent or parsePercent(line)
    end
    local valuation = tonumber(project.val) or 0
    local fair = (percent and percent > 0) and (valuation * percent / 100) or nil
    return money, percent, fair
end

local function suspicious(offer)
    local creds = string.lower(tostring(offer.creds or ""))
    if string.find(creds, "done 3", 1, true) or string.find(creds, "scam", 1, true) then
        return true
    end
    if string.find(creds, "no history", 1, true) then
        return true
    end
    return false
end


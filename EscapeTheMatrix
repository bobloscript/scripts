                                results:Push("<Warning>" .. verdict .. "</Warning>")
                            end
                        else
                            results:Push("<Warning>Submit failed: " .. tostring(submitted.err) .. "</Warning>")
                        end
                    else
                        results:Push("<Muted>Unsupported gig skipped</Muted>")
                    end
                else
                    local text = tostring(started.err or "")
                    local waitFor = tonumber(string.match(text, "in%s+(%d+)s"))
                    if waitFor then
                        pause = waitFor + 0.4
                        results:Push("<Muted>Next gigs in " .. tostring(waitFor) .. "s</Muted>")
                    else
                        results:Push("<Warning>No gig: " .. text .. "</Warning>")
                        pause = 2
                    end
                end
                task.wait(pause)
            end
        end)
    end,

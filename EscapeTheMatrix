local function maxUnits(sym)
    local asset = marketOf(sym)
    if not asset then
        return 0
    end
    local cash = tonumber((Net.state.core or {}).cash) or 0
    local price = tonumber(asset.p) or 0
    if price <= 0 then
        return 0
    end
    local count = math.floor(cash / 100 / (price * (1 + feeOf(asset.cat)) * 1.01))
    if count < 1 then
        return 0
    end
    for _ = 1, 6 do
        local quote = request("TxQuote", sym, "buy", count)
        if not (quote.ok and (((quote.total or 0) > cash) or ((quote.impact or 0) > 0.02))) then
            break
        end
        count = math.floor(count * (((quote.impact or 0) > 0.02) and 0.6 or 0.85))
        if count < 1 then
            return 0
        end
    end
    return count
end

local function emaOf(values, period)
    local factor = 2 / (period + 1)
    local result = values[1]
    for index = 2, #values do
        result = values[index] * factor + result * (1 - factor)
    end
    return result
end

-- News is the same list the TradeX "News" tab shows, newest first, stamped in game minutes.
-- An item counts for 600 game minutes (~5 real minutes) and fades with age.
local function newsScore(sym)
    local minutes = tonumber((Net.state.core or {}).minutes) or 0
    local score = 0
    for index, item in ipairs(((Net.state.mkt or {}).news) or {}) do
        if index > 30 then
            break
        end
        if item.s == sym then
            local stamp = tonumber(item.m) or minutes
            local age = math.max(0, minutes - stamp)
            local fresh = math.clamp(1 - age / 600, 0, 1)
            score += (tonumber(item.x) or 0) * fresh
        end
    end
    return score
end

local function signalOf(sym)
    local chart = request("TxChart", sym)
    if not (chart.ok and type(chart.c) == "table" and #chart.c >= 8) then
        return nil
    end
    local closes = {}
    for _, candle in ipairs(chart.c) do
        local close = tonumber(candle[4])
        if close and close > 0 then
            table.insert(closes, close)
        end
    end
    if #closes < 8 then
        return nil
    end
    local fast = emaOf(closes, 5)
    local slow = emaOf(closes, 10)
    local last = closes[#closes]
    local past = closes[math.max(1, #closes - 5)]
    local momentum = past > 0 and (last / past - 1) or 0
    local asset = marketOf(sym)
    local category = (asset and asset.cat) or "stock"
    local bias, volatility = trendInfo(sym, category)
    local news = newsScore(sym)
    local score = ((fast / slow) - 1) * 1000 + momentum * 100 + news * 4 + bias * 60
    return score, last, momentum, bias, volatility
end

-- Measured on live data: candles move ~2.1% on average, but the lag-1 autocorrelation is
-- only +0.067, so following a candle is worth ~0.02% while a round trip costs 1-2% in fees
-- and impact. Trading candle noise is therefore a losing game by construction; the only
-- real edge is a live trend, which the game applies to prices while it lasts.
local strategy = "trend"

local scan = {}
local scanIndex = 1

local function scanOne(sym)
    local score, _, momentum, bias, volatility = signalOf(sym)
    if not score then
        return
    end
    local asset = marketOf(sym)
    local _, _, names, phase = trendInfo(sym, (asset and asset.cat) or "stock")
    scan[sym] = {
        score = score,
        momentum = momentum or 0,
        bias = bias or 0,
        volatility = volatility or 0,
        names = names,
        phase = phase,
        news = newsScore(sym),
    }
end

local function scanSome(count)
    for _ = 1, count do
        local sym = symbolOrder[scanIndex]
        scanIndex = (scanIndex % #symbolOrder) + 1
        scanOne(sym)
    end
end

local function eligible(entry)
    if strategy == "trend" then
        return entry.bias >= 0.05 and entry.phase <= 0.7
    elseif strategy == "news" then
        return entry.news >= 0.2
    end
    return entry.score >= entryScore
end

local function bestScan(onlyEligible)
    local bestSym, bestScore = nil, -math.huge
    for sym, entry in pairs(scan) do
        local score = type(entry) == "table" and entry.score or tonumber(entry) or 0
        if score > bestScore and (not onlyEligible or (type(entry) == "table" and eligible(entry))) then
            bestSym, bestScore = sym, score
        end
    end
    return bestSym, bestScore
end


    Callback = function(on)
        if not on then
            WorkLog:Push("<Muted>Stopped</Muted>")
            return
        end
        WorkLog:Push("<Success>Started</Success>")
        task.spawn(function()
            while AutoWork.Value do
                local did = false
                for _, activity in ipairs(ACTIVITY_ORDER) do
                    if not AutoWork.Value then
                        break
                    end
                    if runOne(activity) then
                        did = true
                    end
                    task.wait(0.5)
                end
                if not did then
                    task.wait(5)
                end
                local project = currentProject()
                if not project then
                    AutoWork:Set(false)
                    WorkLog:Push("<Muted>No projects left</Muted>")
                end
            end
        end)
    end,
})


-- The lifecycle is a queue over every open project, not just the selected one: publish what
-- is finished, develop what is not, release finished updates, retire games that stopped
-- paying, and open a new one when a slot is free.
local lifeBad = {}
local lifeCreatedAt = 0

local function allOpenProjects()
    local list = {}
    for _, project in pairs((Net.state.rbx or {}).projects or {}) do
        if project.phase ~= "closed" then
            table.insert(list, project)
        end
    end
    table.sort(list, function(first, second)
        if first.phase ~= second.phase then
            return first.phase == "dev"
        end
        return (first.created or 0) < (second.created or 0)
    end)
    return list
end

local function projectCap()
    return (RobluxData and tonumber(RobluxData.MAX_PROJECTS)) or 3
end

local function startProject()
    if os.clock() - lifeCreatedAt < 20 then
        return nil
    end
    lifeCreatedAt = os.clock()
    if RobluxAPI and RobluxAPI.applyBest then
        RobluxAPI.applyBest()
    end
    local created = RobluxAPI and RobluxAPI.create and RobluxAPI.create()
    if created and created.ok then
        LifeLog:Push("<Success>New project started</Success>")
        getgenv().RobluxTarget = created.id
    elseif created then
        LifeLog:Push("<Warning>" .. tostring(created.err) .. "</Warning>")
    end
    return created
end

local function retireProject(project)
    local live = project.live or {}
    local profit = (tonumber(live.earn) or 0) - (tonumber(live.ads) or 0)
    LifeLog:Push(string.format("<Warning>Retiring %s: %.0f CCU of %.0f peak, profit %s</Warning>", tostring(project.title), tonumber(live.ccu) or 0, tonumber(live.peak) or 0, money(profit)))
    local closed = request("RbxClose", project.id)
    if closed.ok then
        lifeBad[tostring(project.id)] = nil
        if getgenv().RobluxTarget == project.id then
            getgenv().RobluxTarget = nil
            selectedId = nil
        end
        return true
    end
    LifeLog:Push("<Warning>" .. tostring(closed.err) .. "</Warning>")
    return false
end

local AutoLife
AutoLife = LifeBox:CreateToggle({
    Name = "Auto lifecycle",
    Desc = "Creates, develops, publishes, updates and retires games on its own",
    Flag = "RobluxAutoLife",
    CurrentValue = false,
    Callback = function(on)
        if not on then
            LifeLog:Push("<Muted>Stopped</Muted>")
            return
        end
        LifeLog:Push("<Success>Started</Success>")
        task.spawn(function()
            while AutoLife.Value do
                local list = allOpenProjects()
                if #list == 0 then
                    startProject()
                    task.wait(5)
                else
                    local publishReady, develop = nil, nil
                    for _, project in ipairs(list) do
                        if project.phase == "dev" then
                            if devProgress(project) >= 1 then
                                publishReady = publishReady or project
                            else
                                develop = develop or project
                            end
                        end
                    end
                    if publishReady then
                        publishProject(publishReady)
                        task.wait(3)
                    elseif develop then
                        local did = false
                        for _, activity in ipairs(ACTIVITY_ORDER) do
                            if not AutoLife.Value then
                                break
                            end
                            if runOne(activity, develop) then
                                did = true
                            end
                            task.wait(0.3)
                        end
                        if not did then
                            task.wait(4)
                        end
                    else
                        local handled = false
                        for _, project in ipairs(list) do
                            if not AutoLife.Value then
                                break
                            end
                            local update = project.update
                            if type(update) == "table" and (tonumber(update.done) or 0) >= (tonumber(update.need) or 1) then
                                local released = request("RbxRelease", project.id)
                                if released.ok then
                                    LifeLog:Push("<Success>Update released: " .. tostring(project.title) .. "</Success>")
                                else
                                    LifeLog:Push("<Warning>" .. tostring(released.err) .. "</Warning>")
                                end
                                handled = true
                                task.wait(2)
                            end
                        end
                        if not handled then
                            local retired = false
                            for _, project in ipairs(list) do
                                if not AutoLife.Value then
                                    break
                                end
                                local live = project.live or {}
                                local ccu = tonumber(live.ccu) or 0
                                local peak = tonumber(live.peak) or 0
                                local profit = (tonumber(live.earn) or 0) - (tonumber(live.ads) or 0)
                                local key = tostring(project.id)
                                -- Dying: traffic collapsed and it no longer pays, or it simply
                                -- stops paying (ads outrun income). Three checks in a row, so a
                                -- short dip does not kill a game.
                                local dying = (isDead(project) and profit <= 0) or profit < 0
                                lifeBad[key] = dying and ((lifeBad[key] or 0) + 1) or 0
                                if (lifeBad[key] or 0) >= 3 then
                                    retired = retireProject(project) or retired
                                end
                            end
                            if retired then
                                task.wait(2)
                                if #allOpenProjects() < projectCap() then
                                    startProject()
                                end
                            else
                                -- nothing to publish or retire: keep every slot busy
                                if #list < projectCap() then
                                    startProject()
                                end
                                task.wait(10)
                            end
                        end
                    end
                end
            end
        end)
    end,
})


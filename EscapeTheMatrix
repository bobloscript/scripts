local function normalize(text)
    local value = string.lower(tostring(text or ""))
    value = string.gsub(value, "%d+", "#")
    value = string.gsub(value, "[^%w# ]", "")
    return value
end

local function signature(activity, content)
    if activity == "script" then
        return normalize(content.title)
    elseif activity == "debug" then
        return normalize(content.log)
    elseif activity == "build" then
        return normalize(content.brief)
    elseif activity == "ui" then
        local parts = {}
        for _, element in ipairs(content.elements or {}) do
            table.insert(parts, normalize(element))
        end
        table.sort(parts)
        return table.concat(parts, "|")
    elseif activity == "anim" then
        return normalize(content.name)
    end
    return normalize(content.title or content.name or content.brief or content.report)
end

local STOP_WORDS = {}
for word in string.gmatch("the a an and or for with that this to of in on is are be it you your they their them when every time some someone my me we our at by as so but not no up out all can just more most too very into from then than there here what which who why how its it's dont dont", "%a+") do
    STOP_WORDS[word] = true
end

local function stems(text)
    local set = {}
    for word in string.gmatch(string.lower(tostring(text or "")), "%a+") do
        if not STOP_WORDS[word] and #word > 2 then
            local stem = string.gsub(word, "ing$", "")
            stem = string.gsub(stem, "ed$", "")
            stem = string.gsub(stem, "es$", "")
            stem = string.gsub(stem, "s$", "")
            set[stem] = true
        end
    end
    return set
end

local function overlapScore(first, second)
    local count = 0
    for key in pairs(first) do
        if second[key] then
            count += 1
        end
    end
    return count
end

local SCRIPT_MARKERS = {
    "no pause", "forever", "every frame", "without waiting", "never stops",
    "brand new", "restart", "lowercase", "exactly", "first match",
    "top to bottom", "inside the", "every time",
}

local function solveScript(content)
    local titleWords = stems(content.title)
    local plain = content.plain or {}
    local best, bestScore = 1, -1
    for index, line in ipairs(plain) do
        local lower = string.lower(tostring(line))
        local score = overlapScore(titleWords, stems(line))
        for _, marker in ipairs(SCRIPT_MARKERS) do
            if string.find(lower, marker, 1, true) then
                score += 1
            end
        end
        if score > bestScore then
            best, bestScore = index, score
        end
    end
    return best
end

local function solveDebug(content)
    local words = stems(tostring(content.report) .. " " .. tostring(content.log))
    local best, bestScore = 1, -1
    for index, option in ipairs(content.options or {}) do
        local score = overlapScore(words, stems(option))
        if score > bestScore then
            best, bestScore = index, score
        end
    end
    return best
end

local BUILD_CATEGORIES = {
    { match = "dark|night|dim|blackout", part = "dark" },
    { match = "scare|tense|fear|horror|spooky", part = "jumpscare" },
    { match = "survive|survival|light|tool", part = "flashlight" },
    { match = "challenge|platform|jump|parkour", part = "moving platform" },
    { match = "save|checkpoint|respawn|restart", part = "checkpoint" },
    { match = "danger|die|deadly|lava|kill", part = "kill brick" },
    { match = "pet|collect|egg|hatch", part = "pet egg" },
    { match = "trade|trading|shop|business", part = "trading booth" },
    { match = "leaderboard|rank|score", part = "leaderboard" },
    { match = "car|dealership|vehicle", part = "car dealership" },
    { match = "reward|drop|gift", part = "dropper" },
    { match = "money|income|profit|earn|cash|coin|dollar", part = "dropper" },
    { match = "invest|upgrade|spend|improve", part = "upgrade button" },
    { match = "conveyor|transport|flow|automat|carry", part = "conveyor" },
    { match = "spawn|start point|begin", part = "spawn point" },
    { match = "chat|social|talk|stage", part = "chat stage" },
    { match = "sword|weapon|fight|combat|battle", part = "sword rack" },
}

-- Lua patterns have no alternation: "a|b|c" matches the literal text "a|b|c".
-- Keyword lists above are split on "|" and compared as plain substrings.
local function hasKeyword(text, list)
    for word in string.gmatch(tostring(list), "[^|]+") do
        if string.find(text, word, 1, true) then
            return true
        end
    end
    return false
end

local function solveBuild(content)
    local brief = string.lower(tostring(content.brief or ""))
    local wanted = {}
    for _, rule in ipairs(BUILD_CATEGORIES) do
        if hasKeyword(brief, rule.match) then
            wanted[rule.part] = true
        end
    end
    local scored = {}
    for index, option in ipairs(content.options or {}) do
        local lower = string.lower(tostring(option))
        local score = 0
        for part in pairs(wanted) do
            if string.find(lower, part, 1, true) then
                score += 2
            end
        end
        score += overlapScore(stems(content.brief), stems(option))
        table.insert(scored, { index = index, score = score })
    end
    table.sort(scored, function(first, second)
        if first.score ~= second.score then
            return first.score > second.score
        end
        return first.index < second.index
    end)
    local picks = {}
    local limit = tonumber(content.pick) or 3
    for i = 1, math.min(limit, #scored) do
        table.insert(picks, scored[i].index)
    end
    return picks
end

-- Zones the game accepts for a UI element. Credits and settings sit in the top corners
-- (either one is fine, they only have to differ), the shop goes where thumbs reach and
-- the middle of the screen must stay free.
local UI_RULES = {
    { match = "currency|cash|coin|gem|money|points|token|bucks|robux", spot = "top-left" },
    { match = "settings|menu|pause|gear|options|close", spot = "top-right" },
    { match = "shop|store|bag|cart|buy|inventory|backpack", spot = "bottom-center" },
    { match = "health|heart|hp|shield|armor|life", spot = "top-left" },
    { match = "map|minimap|compass|radar", spot = "top-right" },
    { match = "chat|log|feed|notification|news", spot = "left side" },
    { match = "joystick|move|jump|sprint|dash|attack|ability", spot = "bottom-center" },
    { match = "timer|clock|score|wave|level|xp|rank", spot = "top-right" },
    { match = "quest|objective|mission|task", spot = "left side" },
    { match = "name|player|profile|avatar", spot = "top-left" },
}

local function findSpot(spots, wanted)
    for index, spot in ipairs(spots) do
        if string.lower(tostring(spot)) == wanted then
            return index
        end
    end
    return nil
end

-- Never park an unknown element in the middle: the game scores that as blocked view.
local UI_FALLBACK = { "bottom-center", "left side", "top-left", "top-right" }
local UI_MIDDLE = "center of screen"

local function isMiddle(spot)
    return string.lower(tostring(spot or "")) == UI_MIDDLE
end

local function solveUi(content)
    local spots = content.spots or {}
    local used = {}
    local answer = {}
    local function take(wanted)
        local found = findSpot(spots, wanted)
        if found and not used[found] then
            return found
        end
        return nil
    end
    for index, element in ipairs(content.elements or {}) do
        local lower = string.lower(tostring(element))
        local pick = nil
        local learnedSpot = solved.ui and solved.ui[normalize(element)]
        if learnedSpot and not isMiddle(learnedSpot) then
            pick = take(string.lower(tostring(learnedSpot)))
        end
        if not pick then
            for _, rule in ipairs(UI_RULES) do
                if hasKeyword(lower, rule.match) then
                    pick = take(rule.spot)
                    if pick then
                        break
                    end
                end
            end
        end
        if not pick then
            for _, wanted in ipairs(UI_FALLBACK) do
                pick = take(wanted)
                if pick then
                    break
                end
            end
        end
        if not pick then
            for spotIndex = 1, #spots do
                if not used[spotIndex] and not isMiddle(spots[spotIndex]) then
                    pick = spotIndex
                    break
                end
            end
        end
        if not pick then
            for spotIndex = 1, #spots do
                if not used[spotIndex] then
                    pick = spotIndex
                    break
                end
            end
        end
        pick = pick or 1
        used[pick] = true
        answer[index] = pick
    end
    return answer
end

local ANIM_RANKS = {
    { match = "anticipation", rank = 1 },
    { match = "wind%-up", rank = 1 },
    { match = "windup", rank = 1 },
    { match = "prep", rank = 1 },
    { match = "action", rank = 2 },
    { match = "swing", rank = 2 },
    { match = "strike", rank = 2 },
    { match = "impact", rank = 2 },
    { match = "push off", rank = 2 },
    { match = "follow%-through", rank = 3 },
    { match = "follow", rank = 3 },
    { match = "overshoot", rank = 3 },
    { match = "settle", rank = 4 },
    { match = "recover", rank = 4 },
    { match = "return", rank = 4 },
    { match = "land", rank = 4 },
}

local function frameRank(frame)
    local lower = string.lower(tostring(frame))
    for _, rule in ipairs(ANIM_RANKS) do
        if string.find(lower, rule.match) then
            return rule.rank
        end
    end
    return 5
end

local function solveAnim(content)
    local order = {}
    for index, frame in ipairs(content.frames or {}) do
        table.insert(order, { index = index, rank = frameRank(frame), name = string.lower(tostring(frame)) })
    end
    table.sort(order, function(first, second)
        if first.rank ~= second.rank then
            return first.rank < second.rank
        end
        return first.name < second.name
    end)
    local answer = {}
    for i = 1, math.min(4, #order) do
        answer[i] = order[i].index
    end
    return answer
end

local function heuristic(activity, content)
    if activity == "script" then
        return solveScript(content)
    elseif activity == "debug" then
        return solveDebug(content)
    elseif activity == "build" then
        return solveBuild(content)
    elseif activity == "ui" then
        return solveUi(content)
    elseif activity == "anim" then
        return solveAnim(content)
    end
    return 1
end

local function matchNameIndex(list, name)
    local target = string.lower(tostring(name))
    target = string.gsub(target, "^%s+", "")
    target = string.gsub(target, "%s+$", "")
    for index, item in ipairs(list or {}) do
        local value = string.lower(tostring(item))
        if value == target then
            return index
        end
    end
    for index, item in ipairs(list or {}) do
        local value = string.lower(tostring(item))
        if string.find(value, target, 1, true) or string.find(target, value, 1, true) then
            return index
        end
    end
    return nil
end

local function learnFromExplain(activity, content, result)
    if result.correct ~= nil then
        return result.correct
    end
    local explain = tostring(result.explain or "")
    if activity == "build" then
        local list = string.match(explain, "brief needed: (.+)%.")
        if list then
            local picks = {}
            for name in string.gmatch(list, "[^,]+") do
                local index = matchNameIndex(content.options or {}, name)
                if index then
                    table.insert(picks, index)
                end
            end
            if #picks > 0 then
                return picks
            end
        end
    elseif activity == "anim" then
        local list = string.match(explain, "Order: (.+)")
        if list then
            local order = {}
            for name in string.gmatch(list, "([^>]+)") do
                local index = matchNameIndex(content.frames or {}, name)
                if index then
                    table.insert(order, index)
                end
            end
            if #order == #(content.frames or {}) then
                return order
            end
        end
    end
    return nil
end

local function namesToIndices(list, names)
    local answer = {}
    for _, name in ipairs(names or {}) do
        local index = matchNameIndex(list, name)
        if not index then
            return nil
        end
        table.insert(answer, index)
    end
    return answer
end

local currentProject = function()
    local target = getgenv().RobluxTarget
    if target then
        for _, project in pairs((Net.state.rbx or {}).projects or {}) do
            if project.id == target and project.phase ~= "closed" then
                return project
            end
        end
    end
    local newest = nil
    for _, project in pairs((Net.state.rbx or {}).projects or {}) do
        if project.phase == "dev" or project.phase == "live" then
            if not newest or (project.created or 0) > (newest.created or 0) then
                newest = project
            end
        end
    end
    return newest
end

local ACTIVITY_ORDER = { "script", "build", "ui", "anim", "debug" }

-- Every project has its own 20 s cooldown per activity (verified in the client: a session
-- on one project does not block the same activity on another). That is what makes working
-- several games at once possible: projects take turns while their own timers tick down.
local function openProjects()
    local list = {}
    for _, project in pairs((Net.state.rbx or {}).projects or {}) do
        if project.phase ~= "closed" then
            local parts = project.parts or {}
            local progress = tonumber(parts.progress) or 0
            local update = project.update
            local developing = project.phase == "dev" and progress < 1
            local updating = type(update) == "table" and (tonumber(update.done) or 0) < (tonumber(update.need) or 0)
            if developing or updating then
                table.insert(list, project)
            end
        end
    end
    table.sort(list, function(first, second)
        if first.phase ~= second.phase then
            return first.phase == "dev"
        end
        return (first.created or 0) < (second.created or 0)
    end)
    return list
end

local function runOne(activity, target)
    local project = target or currentProject()
    if not project then
        WorkLog:Push("<Warning>No project in development</Warning>")
        return false
    end
    local label = ""
    if target then
        label = "<Muted>" .. tostring(project.title or project.id) .. " #" .. tostring(project.id) .. ":</Muted> "
    end
    local session = request("RbxSession", project.id, activity)
    if not session.ok then
        local message = tostring(session.err or "")
        if string.find(string.lower(message), "breather") then
            return false
        end
        WorkLog:Push("<Warning>" .. message .. "</Warning>")
        return false
    end
    local content = session.content or {}
    local key = signature(activity, content)
    local learned = solved[activity] and solved[activity][key]
    local answer = nil
    if learned ~= nil then
        if activity == "build" or activity == "anim" then
            local list = (activity == "build") and content.options or content.frames
            answer = namesToIndices(list, learned)
        else
            answer = learned
        end
    end
    local fromCache = answer ~= nil
    answer = answer or heuristic(activity, content)
    local result = request("RbxSubmit", session.sid, answer)
    if not result.ok then
        WorkLog:Push("<Warning>" .. tostring(result.err) .. "</Warning>")
        return false
    end
    local score = tonumber(result.score) or 0
    stats.jobs += 1
    stats.scoreSum += score
    if score >= 0.99 then
        stats.full += 1
    end
    if result.correct ~= nil then
        solved[activity] = solved[activity] or {}
        solved[activity][key] = result.correct
        saveCache()
    else
        local explain = tostring(result.explain or "")
        if activity == "build" then
            local list = string.match(explain, "brief needed: (.+)%.")
            if list then
                local names = {}
                for name in string.gmatch(list, "[^,]+") do
                    table.insert(names, (string.gsub(name, "^%s+", "")))
                end
                if #names > 0 then
                    solved.build = solved.build or {}
                    solved.build[key] = names
                    saveCache()
                end
            end
        elseif activity == "anim" then
            local list = string.match(explain, "Order: (.+)")
            if list then
                local names = {}
                for name in string.gmatch(list, "([^>]+)") do
                    table.insert(names, (string.gsub(name, "^%s+", "")))
                end
                if #names > 0 then
                    solved.anim = solved.anim or {}
                    solved.anim[key] = names
                    saveCache()
                end
            end
        elseif activity == "ui" then
            -- A partial score never says which element missed, so probing on failure only
            -- poisons the cache. Only a perfect layout is worth remembering.
            if score >= 0.99 then
                solved.ui = solved.ui or {}
                for index, element in ipairs(content.elements or {}) do
                    local spot = (content.spots or {})[answer[index]]
                    if spot then
                        solved.ui[normalize(element)] = string.lower(tostring(spot))
                    end
                end
                saveCache()
            end
        end
    end
    local color = score >= 0.99 and "Success" or (score >= 0.5 and "Warning" or "Error")
    local prefix = fromCache and " (known)" or ""
    WorkLog:Push(label .. "<" .. color .. ">" .. activity .. " " .. math.floor(score * 100) .. "%" .. prefix .. "</" .. color .. "> <Muted>+" .. string.format("%.1f", result.work or 0) .. " work</Muted>")
    return true
end

local AutoWork
AutoWork = WorkBox:CreateToggle({
    Name = "Auto work",
    Desc = "Opens a task, solves it and submits the work",
    Flag = "RobluxAutoWork",

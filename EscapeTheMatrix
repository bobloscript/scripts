----- helpers -----

local function money(value)
    if Format and type(Format.money) == "function" then
        local ok, text = pcall(Format.money, value)
        if ok then
            return text
        end
    end
    return "$" .. tostring(math.floor(tonumber(value) or 0))
end

local function request(action, ...)
    local pack = table.pack(...)
    local ok, result = pcall(function()
        return Net.request(action, table.unpack(pack, 1, pack.n))
    end)
    if not ok then
        return { ok = false, err = tostring(result) }
    end
    if type(result) ~= "table" then
        return { ok = false, err = "empty response" }
    end
    return result
end


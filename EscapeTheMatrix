local function loadCache()
    if type(isfile) ~= "function" or type(readfile) ~= "function" then
        return
    end
    local ok, exists = pcall(isfile, CACHE_PATH)
    if not ok or not exists then
        return
    end
    local decoded = pcall(function()
        return HttpService:JSONDecode(readfile(CACHE_PATH))
    end)
    if type(decoded) == "table" then
        solved = decoded
        -- v1.8 learned layouts from failed runs, so those entries are dropped once.
        if solved.uiVersion ~= UI_CACHE_VERSION then
            solved.ui = {}
            solved.uiVersion = UI_CACHE_VERSION
        end
    end
end

local function saveCache()
    if type(writefile) ~= "function" then
        return
    end
    pcall(function()
        writefile(CACHE_PATH, HttpService:JSONEncode(solved))
    end)
end


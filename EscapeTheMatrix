})

-- The game keeps development progress in project.parts.progress (0..1) and polish in
-- project.parts.polish (0..100). Publishing unlocks at 50%, 100% is a complete game.
local function devProgress(project)
    local parts = (project and project.parts) or {}
    return tonumber(parts.progress) or tonumber(project and project.progress) or 0
end

local function devPolish(project)
    local parts = (project and project.parts) or {}
    return tonumber(parts.polish) or 0
end

local publishDefaults = {
    thumb = "clean",
    desc = "honest",
    monet = "fair",
    timing = "now",
    ads = 0,
}

local function deadRatio()
    return tonumber(getgenv().RobluxDeadRatio) or 0.05
end

local function deadPeak()
    return tonumber(getgenv().RobluxDeadPeak) or 200
end

local function isDead(project)
    local live = (project and project.live) or {}
    local ccu = tonumber(live.ccu) or 0
    local peak = tonumber(live.peak) or 0
    if peak < deadPeak() then
        return false
    end
    return ccu < peak * deadRatio()
end

local function publishProject(project)
    if not project then
        return
    end
    if devProgress(project) < 0.5 then
        LifeLog:Push("<Warning>Needs 50% to publish</Warning>")
        return
    end
    local payload = {
        thumb = publishDefaults.thumb,
        desc = publishDefaults.desc,
        monet = publishDefaults.monet,
        timing = publishDefaults.timing,
        ads = publishDefaults.ads,
    }
    local result = request("RbxPublish", project.id, payload)
    if result.ok then
        LifeLog:Push("<Success>Published " .. tostring(project.title) .. "</Success>")
    else
        LifeLog:Push("<Warning>" .. tostring(result.err) .. "</Warning>")
    end
    return result
end


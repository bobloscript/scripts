local function refreshStatus()
	local bits = {}
	if state.ESPEnabled then
		table.insert(bits, "ESP")
	end
	if state.AutoCook then
		table.insert(bits, "Cook")
	end
	if state.AutoGrabCoffee then
		table.insert(bits, "Coffee")
	end
	if #bits == 0 then
		statusRow:SetValue("Idle")
		statusRow:SetStatus("Neutral")
	else
		statusRow:SetValue(table.concat(bits, " · "))
		statusRow:SetStatus("Success")
	end
end


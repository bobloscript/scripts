local function unload()
	if unloaded then
		return
	end
	unloaded = true
	alive = false
	state.ESPEnabled = false
	state.AutoCook = false
	state.AutoGrabCoffee = false
	clearESP()
	pcall(function()
		ESPHolder:Destroy()
	end)
	pcall(function()
		UI:Unload()
	end)
	getgenv().__ANOMALY = nil
end

